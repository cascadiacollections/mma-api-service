PORT=8000
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
# Optional webmaster verification tokens. DNS verification is preferred.
# GOOGLE_SITE_VERIFICATION=replace-with-google-token
# BING_SITE_VERIFICATION=replace-with-bing-token
# Optional Bing/IndexNow key (8-128 letters, numbers, or dashes).
# INDEXNOW_KEY=replace-with-random-indexnow-key
# Optional Google AdSense configuration. Keep unset until the domain is approved.
# ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000
# ADSENSE_SLOT_ID=0000000000
# Optional shared cache for multi-instance deployments:
# REDIS_URL=redis://localhost:6379/0
