{
  "name": "MMA API Service",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  // No named volume for the uv cache: under rootless Podman the volume is
  // created root-owned and `uv sync` then fails with EACCES in
  // postCreateCommand. An image-owned cache directory works on every engine.
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv"
  },
  // Resolved against the real workspace folder, so a clone directory with
  // any name still puts the project venv first on PATH.
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "uv sync --frozen",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "MMA Pick'em",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
